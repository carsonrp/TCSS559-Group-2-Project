{
  "name": "meetingloop",
  "version": "1.0.0",
  "description": "MeetingLoop backend for meeting lifecycle management",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/validation.test.js tests/action-items-dependencies.test.js && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/meeting-management.jest.test.js",
    "test:jest": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "keywords": [
    "meetingloop",
    "express",
    "postgresql",
    "services-computing"
  ],
  "author": "TCSS559 Group 2",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  }
}
